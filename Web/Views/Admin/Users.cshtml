@model IEnumerable<Aymane.netProjet.Entities.Client>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0 rounded-xl">
    <div class="card-header bg-white p-4 border-bottom">
        <h4 class="mb-0 fw-bold">User Management</h4>
        <p class="text-muted mb-0 small">Manage registered customers</p>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-gray-100 text-uppercase small fw-bold text-secondary">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">#@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary-soft text-primary p-2 me-3 d-flex align-items-center justify-content-center" style="width:35px;height:35px">
                                        <span class="fw-bold small">@user.Prenom.Substring(0,1).ToUpper()@user.Nom.Substring(0,1).ToUpper()</span>
                                    </div>
                                    <div>
                                        <span class="d-block fw-bold text-dark">@user.Prenom @user.Nom</span>
                                    </div>
                                </div>
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td class="text-muted">@user.Telephone</td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("DeleteUser", "Admin", new { id = user.Id })" 
                                   class="btn btn-light btn-sm rounded-pill text-danger"
                                   onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.');" title="Delete User">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
