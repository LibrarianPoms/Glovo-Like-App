@model IEnumerable<Aymane.netProjet.Entities.Produit>
@{
    ViewData["Title"] = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0 rounded-xl">
    <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-0">Product Management</h4>
            <p class="text-muted mb-0 small">Manage your menu items</p>
        </div>
        <a href="@Url.Action("CreateProduct", "Admin")" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i> Add Product
        </a>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-gray-100 text-uppercase small fw-bold text-secondary">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">#@item.Id</td>
                            <td class="fw-bold text-dark">@item.Titre</td>
                            <td class="text-muted text-truncate" style="max-width: 200px;">@item.Description</td>
                            <td class="fw-bold text-primary">@item.Prix.ToString("C")</td>
                            <td>
                                @if (item.Stock)
                                {
                                    <span class="badge bg-success-soft text-success rounded-pill px-3">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-soft text-danger rounded-pill px-3">Out of Stock</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("EditProduct", "Admin", new { id = item.Id })" class="btn btn-light btn-sm rounded-pill text-primary me-2" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("DeleteProduct", "Admin", new { id = item.Id })" 
                                   class="btn btn-light btn-sm rounded-pill text-danger"
                                   onclick="return confirm('Are you sure you want to delete this product?');" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
