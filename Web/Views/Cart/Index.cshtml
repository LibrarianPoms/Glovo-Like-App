@model List<Aymane.netProjet.Models.CartItemViewModel>
@{
    ViewData["Title"] = "Your Cart";
}

<div class="container mt-5">
    
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["CartError"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div class="alert alert-info d-inline-block px-5 py-4 rounded-xl shadow-sm border-0 bg-white">
                <i class="fas fa-shopping-basket fa-3x mb-3 d-block text-info"></i>
                <h4 class="fw-bold">Your cart is empty</h4>
                <p class="mb-4 text-muted">Looks like you haven't added any food yet.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    Start Ordering
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- PROGRESS STEPS -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between position-relative">
                    <div class="position-absolute top-50 start-0 w-100 translate-middle-y bg-gray-200 rounded" style="height: 4px; z-index: 0;"></div>
                    
                    <div class="position-relative z-1 text-center">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm mx-auto mb-2" style="width: 40px; height: 40px;">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <span class="small fw-bold text-primary">Cart</span>
                    </div>

                    <div class="position-relative z-1 text-center opacity-50">
                        <div class="rounded-circle bg-white border border-2 border-secondary text-secondary d-flex align-items-center justify-content-center shadow-sm mx-auto mb-2" style="width: 40px; height: 40px;">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <span class="small fw-bold text-muted">Details</span>
                    </div>

                    <div class="position-relative z-1 text-center opacity-50">
                        <div class="rounded-circle bg-white border border-2 border-secondary text-secondary d-flex align-items-center justify-content-center shadow-sm mx-auto mb-2" style="width: 40px; height: 40px;">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <span class="small fw-bold text-muted">Confirm</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Cart Items -->
            <div class="col-lg-8">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h2 class="fw-bold mb-0">Shopping Cart <span class="badge bg-primary-soft text-primary fs-6 align-middle ms-2">@Model.Sum(i => i.Quantite) items</span></h2>
                </div>

                <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
                    <div class="card-body p-0">
                        @foreach (var item in Model)
                        {
                            <div class="p-4 border-bottom last-border-0 transition-hover">
                                <div class="row align-items-center">
                                    <!-- Product Info -->
                                    <div class="col-md-6 mb-3 mb-md-0">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0 bg-gray-100 rounded-3 p-3 text-center me-3" style="width: 80px; height: 80px;">
                                                <i class="fas fa-hamburger text-warning fa-2x"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-dark mb-1">@item.Titre</h5>
                                                <p class="text-muted small mb-0">Unit Price: @item.Prix.ToString("C")</p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Quantity Control -->
                                    <div class="col-6 col-md-3">
                                        <form asp-action="Update" method="post" class="d-flex align-items-center">
                                            <input type="hidden" name="productId" value="@item.ProduitId" />
                                            <div class="input-group input-group-sm">
                                                <input type="number" name="quantity" value="@item.Quantite" min="1" class="form-control text-center fw-bold border-secondary text-secondary" style="max-width: 70px;" onchange="this.form.submit()" />
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Total & Remove -->
                                    <div class="col-6 col-md-3 text-end">
                                        <h5 class="fw-bold text-primary mb-2">@item.Total.ToString("C")</h5>
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProduitId" />
                                            <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none small">
                                                <i class="fas fa-trash-alt me-1"></i> Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                        <i class="fas fa-arrow-left me-2"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Right Column: Order Summary (Sticky) -->
            <div class="col-lg-4">
                @{ var grandTotal = Model.Sum(i => i.Total); }
                <div class="card border-0 shadow-lg rounded-xl sticky-top" style="top: 100px; z-index: 1;">
                    <div class="card-header bg-gradient-primary text-white p-4 border-0">
                        <h4 class="fw-bold mb-0"><i class="fas fa-receipt me-2"></i> Order Summary</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold">@grandTotal.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Delivery</span>
                            <span class="text-success fw-bold">Free</span>
                        </div>
                        <hr class="my-4 border-gray-200">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="h5 fw-bold mb-0">Total</span>
                            <span class="h3 fw-bold text-primary mb-0">@grandTotal.ToString("C")</span>
                        </div>

                        <form asp-action="Checkout" method="post">
                            <div class="mb-3">
                                <label class="form-label small text-uppercase fw-bold text-muted">Delivery Address</label>
                                <textarea name="adresse" class="form-control bg-gray-100 border-0" rows="3" placeholder="Enter your full address..." required></textarea>
                            </div>
                            <div class="mb-4">
                                <label class="form-label small text-uppercase fw-bold text-muted">Phone Number</label>
                                <input type="text" name="telephone" class="form-control bg-gray-100 border-0" placeholder="+1 234 567 890" required />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill shadow-glow fw-bold">
                                Checkout Now <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .last-border-0:last-child { border-bottom: none !important; }
    .bg-gray-100 { background-color: var(--gray-100); }
</style>
