@model Aymane.netProjet.Entities.Commande

@{
    ViewData["Title"] = "Détail de la Commande";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📦 Commande #@Model.Id</h2>
        <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Informations Client</h5>
                </div>
                <div class="card-body">
                    <p><strong>Client ID:</strong> @Model.ClientId</p>
                    <p><strong>Adresse de livraison:</strong> @Model.Adresse</p>
                    <p><strong>Date de commande:</strong> @Model.CreateAt.ToString("g")</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Résumé</h5>
                </div>
                <div class="card-body text-center">
                    <h3 class="text-primary mb-3">Total : @Model.Montant.ToString("C")</h3>
                    <p>Statut actuel : 
                        <span class="badge @(Model.Statut == Aymane.netProjet.Shared.StatutCommande.Livree ? "bg-success" : "bg-warning text-dark")">
                            @Model.Statut
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
