@{
    ViewData["Title"] = "Commande Confirmée";
    Layout = "_Layout";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm p-5">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h1 class="display-4 fw-bold text-success">Merci !</h1>
        <p class="lead mb-4">Votre commande a été enregistrée avec succès.</p>
        <p>Notre équipe va traiter votre commande dans les plus brefs délais.</p>
        
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Retour à l'accueil</a>
        </div>
    </div>
</div>
