@model IEnumerable<Aymane.netProjet.Entities.Commande>

@{
    ViewData["Title"] = "Gestion des Commandes";
}

<div class="container mt-4">
    <h2 class="mb-4">📋 Liste des Commandes</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Client ID</th>
                        <th>Date</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>@item.ClientId</td>
                            <td>@item.CreateAt.ToString("g")</td>
                            <td>@item.Montant.ToString("C")</td>
                            <td>
                                <span class="badge @(item.Statut == Aymane.netProjet.Shared.StatutCommande.Livree ? "bg-success" : "bg-warning text-dark")">
                                    @item.Statut
                                </span>
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Détails</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
