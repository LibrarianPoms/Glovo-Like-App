<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodDudes</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aymane.netProjet.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    @{
        var role = Context.Session.GetString("Role");
    }

    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container container-gl">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-hamburger me-2 text-warning display-6"></i>
                    <span>FoodDudes</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="fas fa-bars"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Home
                            </a>
                        </li>

                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i> Dashboard
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @* NOT LOGGED IN *@
                        @if (string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link" asp-controller="Client" asp-action="Signup">
                                    Sign up
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-4 rounded-pill shadow-glow" asp-controller="Client" asp-action="Login">
                                    Sign in
                                </a>
                            </li>
                        }

                        @* ADMIN *@
                        else if (role == "Admin")
                        {
                            <li class="nav-item me-3">
                                <span class="nav-link fw-bold text-gradient">
                                    <i class="fas fa-crown me-1 text-warning"></i> Admin
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                   asp-controller="Client" asp-action="Logout">
                                   <i class="fas fa-sign-out-alt me-1"></i> Logout
                                </a>
                            </li>
                        }

                        @* CLIENT *@
                        else if (role == "Client")
                        {
                            var cartJson = Context.Session.GetString("Cart");
                            var cartCount = 0;
                            if (!string.IsNullOrEmpty(cartJson))
                            {
                                try
                                {
                                    var items = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.List<Aymane.netProjet.Models.CartItemViewModel>>(cartJson);
                                    cartCount = items?.Sum(i => i.Quantite) ?? 0;
                                }
                                catch { }
                            }

                            <li class="nav-item me-3">
                                <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                                    <i class="fas fa-shopping-cart me-1"></i>
                                    Cart
                                    @if (cartCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle">@cartCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link" asp-controller="Commande" asp-action="MyOrders">
                                    <i class="fas fa-receipt me-1"></i> My Orders
                                </a>
                            </li>
                            <li class="nav-item me-3">
                                <span class="nav-link fw-bold text-success d-flex align-items-center">
                                    <div class="bg-warning rounded-circle p-1 me-2 d-flex align-items-center justify-content-center text-white shadow-sm" style="width:32px;height:32px;">
                                        <i class="fas fa-user mb-0"></i>
                                    </div>
                                    @Context.Session.GetString("ClientPrenom") @Context.Session.GetString("ClientNom")
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                   asp-controller="Client" asp-action="Logout">
                                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-5 pt-5">
        <main role="main" class="animate-fade-in">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center py-3">
            &copy; 2025 - <span class="fw-bold text-gradient">FoodDudes</span> |
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
