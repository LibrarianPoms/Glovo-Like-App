<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodDudes Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8f9fa;
            overflow-x: hidden;
        }
        
        /* Sidebar Styling */
        #sidebar-wrapper {
            min-height: 100vh;
            margin-left: -250px;
            -webkit-transition: margin .25s ease-out;
            -moz-transition: margin .25s ease-out;
            -o-transition: margin .25s ease-out;
            transition: margin .25s ease-out;
            border-right: 1px solid rgba(0,0,0,0.05);
            background: white;
            position: fixed;
            width: 250px;
            z-index: 1000;
        }
        
        #sidebar-wrapper .sidebar-heading {
            padding: 1.5rem 1.5rem;
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary);
            display: flex;
            align-items: center;
        }
        
        #sidebar-wrapper .list-group {
            width: 250px;
        }
        
        #sidebar-wrapper .list-group-item {
            border: none;
            padding: 1rem 1.5rem;
            font-weight: 500;
            color: #64748b;
            transition: all 0.3s;
        }
        
        #sidebar-wrapper .list-group-item:hover {
            color: var(--primary);
            background-color: var(--primary-op);
            padding-left: 2rem;
        }
        
        #sidebar-wrapper .list-group-item.active {
            color: var(--primary);
            background-color: var(--primary-op);
            border-left: 4px solid var(--primary);
        }

        #page-content-wrapper {
            width: 100%;
            padding-left: 250px; 
            transition: all 0.25s ease;
        }

        /* Topbar */
        .admin-topbar {
            height: 80px;
            background: transparent;
            display: flex;
            align-items: center;
            padding: 0 2rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            #sidebar-wrapper {
                margin-left: -250px;
            }
            #page-content-wrapper {
                padding-left: 0;
            }
            #wrapper.toggled #sidebar-wrapper {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="fas fa-hamburger me-2 text-gradient"></i> FoodDudes
            </div>
            <div class="list-group list-group-flush my-3">
                <a href="@Url.Action("Dashboard", "Admin")" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"].ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-th-large me-3 w-5"></i> Dashboard
                </a>
                <a href="@Url.Action("Users", "Admin")" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"].ToString() == "Users" ? "active" : "")">
                    <i class="fas fa-users me-3 w-5"></i> Users
                </a>
                <a href="@Url.Action("Products", "Admin")" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"].ToString() == "Products" ? "active" : "")">
                    <i class="fas fa-box-open me-3 w-5"></i> Products
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-cog me-3 w-5"></i> Settings
                </a>
            </div>
            
            <div class="mt-auto p-4 border-top">
                <a asp-controller="Client" asp-action="Logout" class="btn btn-outline-danger w-100 rounded-pill">
                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <div class="admin-topbar justify-content-between">
                <h4 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h4>
                
                <div class="d-flex align-items-center">
                    <div class="dropdown me-3">
                        <a href="#" class="text-secondary position-relative" id="notifDropdown" data-bs-toggle="dropdown">
                            <i class="far fa-bell fa-lg"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">3</span>
                        </a>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark fw-bold" id="userDropdown" data-bs-toggle="dropdown">
                           <div class="bg-gradient-primary rounded-circle text-white d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 40px; height: 40px;">
                               A
                           </div>
                           <span>Admin</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-2" aria-labelledby="userDropdown">
                             <li><a class="dropdown-item rounded" href="#">Profile</a></li>
                             <li><a class="dropdown-item rounded" href="#">Settings</a></li>
                             <li><hr class="dropdown-divider"></li>
                             <li><a class="dropdown-item rounded text-danger" asp-controller="Client" asp-action="Logout">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="container-fluid px-4 pb-5">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
