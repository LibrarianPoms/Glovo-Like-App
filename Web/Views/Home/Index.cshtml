@model List<Aymane.netProjet.Models.ProduitListViewModel>

@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<header class="hero-section text-center py-5 mb-5 bg-gradient-primary text-white rounded-xl shadow-lg position-relative overflow-hidden">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at center, rgba(255,255,255,0.2) 0%, transparent 70%); pointer-events: none;"></div>
    <div class="container position-relative z-1 py-5">
        <h1 class="display-3 fw-bold mb-3 animate-fade-in">Hungry? FoodDudes.</h1>
        <p class="lead mb-4 fs-4 text-white-50 animate-fade-in" style="animation-delay: 0.2s;">
            Delicious meals delivered with style. Explore our premium selection.
        </p>
        <a href="#products" class="btn btn-light text-primary fw-bold rounded-pill px-5 py-3 shadow-lg animate-fade-in" style="animation-delay: 0.4s;">
            <i class="fas fa-utensils me-2"></i> Order Now
        </a>
    </div>
</header>

<div id="products" class="container product-grid-container mt-5">

    @if (Model != null && Model.Any())
    {
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6 text-gradient d-inline-block border-bottom border-2 border-warning pb-2">Our Menu</h2>
        </div>
        
        <div class="row g-4">
            @foreach (var produit in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 product-card border-0">
                        <div class="card-header border-0 bg-transparent pt-4 pb-0">
                            <!-- Placeholder Icon for Food if no image is available -->
                            <div class="bg-gradient-primary rounded-circle d-flex align-items-center justify-content-center mx-auto text-white shadow-soft" style="width: 80px; height: 80px;">
                                <i class="fas fa-hamburger fa-2x"></i>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column text-center">
                            <h5 class="card-title fw-bold text-dark mt-2 text-truncate">@produit.Titre</h5>
                            <p class="card-text text-muted small flex-grow-1 px-2">@produit.Description</p>
                            
                            <h4 class="fw-bold text-primary my-3">
                                @produit.Prix.ToString("C")
                            </h4>

                            <div class="d-grid gap-2">
                                <form asp-controller="Cart" asp-action="Add" method="post" class="w-100">
                                    <input type="hidden" name="productId" value="@produit.Id" />
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm">
                                        Add to Cart
                                    </button>
                                </form>
                                <a asp-controller="Commande"
                                   asp-action="Create"
                                   asp-route-produitId="@produit.Id"
                                   class="btn btn-outline-secondary w-100 rounded-pill border-0 bg-gray-100 text-dark">
                                    Quick Order
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
             <div class="alert alert-warning d-inline-block px-5 py-4 rounded-xl shadow-sm">
                <i class="fas fa-cookie-bite fa-3x mb-3 d-block text-warning"></i>
                <h4 class="fw-bold">No items found</h4>
                <p class="mb-0">Check back later for fresh food!</p>
            </div>
        </div>
    }
</div>
